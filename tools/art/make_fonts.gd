func _init() -> void:
	_write_font("hearth_pixel", "Hearth Pixel", PIXEL_GLYPHS, 9, 7, 11, 4)
	_write_font("hearth_micro", "Hearth Micro", MICRO_GLYPHS, 5, 5, 6, 2)
	print("fonts done")
	quit()


## Packs [param glyphs] into one PNG and writes a BMFont text file next to it.
## [param cell_height]: rows per glyph (with descenders), [param base]: baseline,
## [param line_height]: distance between lines, [param space]: width of a space.
func _write_font(file_name: String, face: String, glyphs: Dictionary, cell_height: int,
		base: int, line_height: int, space: int) -> void:
	var width := 256
	var x := 0
	var y := 0
	var placed: Array = []
	for character: String in glyphs:
		var rows: Array = glyphs[character]
		var glyph_width: int = (rows[0] as String).length()
		if x + glyph_width + 1 > width:
			x = 0
			y += cell_height + 1
		placed.append([character, x, y, glyph_width])
		x += glyph_width + 1
	var height := y + cell_height + 1
	var image := Image.create(width, height, false, Image.FORMAT_RGBA8)
	image.fill(Color(1, 1, 1, 0))
	var lines := PackedStringArray()
	lines.append('info face="%s" size=%d bold=0 italic=0 charset="" unicode=1 stretchH=100 smooth=0 aa=0 padding=0,0,0,0 spacing=1,1' % [face, line_height])
	lines.append("common lineHeight=%d base=%d scaleW=%d scaleH=%d pages=1 packed=0" % [line_height, base, width, height])
	lines.append('page id=0 file="%s.png"' % file_name)
	lines.append("chars count=%d" % (placed.size() + 1))
	lines.append("char id=32 x=0 y=0 width=0 height=0 xoffset=0 yoffset=0 xadvance=%d page=0 chnl=15" % space)
	for entry: Array in placed:
		var character: String = entry[0]
		var gx: int = entry[1]
		var gy: int = entry[2]
		var glyph_width: int = entry[3]
		var rows: Array = glyphs[character]
		for row: int in rows.size():
			var pattern: String = rows[row]
			for column: int in pattern.length():
				if pattern[column] == "#":
					image.set_pixel(gx + column, gy + row, Color.WHITE)
		lines.append("char id=%d x=%d y=%d width=%d height=%d xoffset=0 yoffset=0 xadvance=%d page=0 chnl=15" % [
			character.unicode_at(0), gx, gy, glyph_width, cell_height, glyph_width + 1])
	image.save_png("res://assets/fonts/%s.png" % file_name)
	var file := FileAccess.open("res://assets/fonts/%s.fnt" % file_name, FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
