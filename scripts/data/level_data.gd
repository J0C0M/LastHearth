class_name LevelData
extends Resource
## Settings of one level: goal, time until dawn, resource, map and tools.
## Alle balanswaarden staan hier, zodat je ze in de Inspector kunt aanpassen
## zonder code te openen (zie resources/levels/).

enum Goal {
	DEFEND, ## Keep the hearth burning until dawn (level 1).
	EXTINGUISH, ## Put the hearth out before dawn (level 2).
}

enum MapType {
	TEST, ## Fixed test level with dummy data (PT-04).
	LEVEL_1, ## Generated by Level1Map (duo A).
	LEVEL_2, ## Generated by Level2Map (duo B).
}

## The toolbar has keys 1-7, so a level has at most this many tools.
const MAX_TOOLS := 7

## Stable identifier, for example [code]&"level_1"[/code].
@export var id: StringName = &""
## Name shown in the level select, for example "Hold the Light".
@export var title: String = ""
## Text shown before the level starts.
@export_multiline var briefing: String = ""
@export var goal: Goal = Goal.DEFEND

@export_group("Map")
@export var map_type: MapType = MapType.TEST
## Seed for the map generator. The same seed always gives the same map.
@export var map_seed: int = 0

@export_group("Time")
## Seconds until dawn at 1x speed (4:30 = 270).
@export var dawn_time: float = 270.0
## Seconds dawn is pushed back for every villager killed (level 2).
@export var dawn_delay_per_kill: float = 0.0

@export_group("Resource")
## Name of the resource in the interface: "Light" or "Dread".
@export var resource_label: String = "Light"
## Icon of the resource in the interface (flame or dread eye).
@export var resource_icon: Texture2D = null
@export var start_resource: float = 0.0
@export var max_resource: float = 100.0
## Resource gained per second.
@export var regen: float = 1.0
## Resource gained for every villager killed (level 2).
@export var resource_per_kill: float = 0.0

@export_group("World")
@export var hearth_hp: float = 100.0
## How fast gloom spreads, in tiles per second.
@export var gloom_speed: float = 0.1
@export var max_houses: int = 10

@export_group("Village")
## Villagers at the start of the round; every third one is a guard.
@export var start_villagers: int = 4

@export_group("Waves")
## Seconds until the first wave of enemies comes out of the pits.
@export var first_wave_at: float = 10.0
## Seconds between waves. 0 means no automatic waves (level 2: you are the dark).
@export var wave_interval: float = 0.0
## The enemy types the waves are made of (see WaveSpawner.spawn_wave()).
@export var shadow: EnemyData
@export var wraith: EnemyData
@export var brute: EnemyData

@export_group("")
## Tools in toolbar order (key 1 is the first tool).
@export var tools: Array[ToolData] = []


## Returns the tool with [param tool_id], or null if this level does not have it.
func find_tool(tool_id: StringName) -> ToolData:
	for tool: ToolData in tools:
		if tool != null and tool.id == tool_id:
			return tool
	return null


## Clamps [param value] between 0 and [member max_resource].
func clamp_resource(value: float) -> float:
	return clampf(value, 0.0, max_resource)
