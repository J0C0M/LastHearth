[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/data/level_data.gd" id="2_level_data"]
[ext_resource type="Resource" path="res://resources/levels/level_1.tres" id="3_level_1"]
[ext_resource type="Resource" path="res://resources/levels/level_2.tres" id="4_level_2"]
[ext_resource type="Resource" path="res://resources/levels/test_level.tres" id="5_test_level"]
[ext_resource type="SpriteFrames" path="res://assets/sprites/fire_frames.tres" id="6_fire"]
[ext_resource type="Shader" path="res://scenes/ui/vignette.gdshader" id="7_vignette"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
shader = ExtResource("7_vignette")
shader_parameter/strength = 0.85

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")
levels = Array[ExtResource("2_level_data")]([ExtResource("3_level_1"), ExtResource("4_level_2")])
test_level = ExtResource("5_test_level")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.03, 0.02, 0.07, 0.35)

[node name="Vignette" type="ColorRect" parent="."]
material = SubResource("ShaderMaterial_vignette")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="FireSpot" type="Control" parent="Center/Box"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2

[node name="Fire" type="AnimatedSprite2D" parent="Center/Box/FireSpot"]
unique_name_in_owner = true
position = Vector2(110, 26)
scale = Vector2(2, 2)
sprite_frames = ExtResource("6_fire")
autoplay = "default"

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.42, 1)
theme_override_colors/font_shadow_color = Color(0.35, 0.12, 0.05, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 33
text = "LAST HEARTH"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.72, 0.66, 1)
text = "Keep the last fire alive, or snuff it out."
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Center/Box"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2

[node name="Panel" type="PanelContainer" parent="Center/Box"]
custom_minimum_size = Vector2(244, 0)
layout_mode = 2
size_flags_horizontal = 4

[node name="Buttons" type="VBoxContainer" parent="Center/Box/Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="LevelButtons" type="VBoxContainer" parent="Center/Box/Panel/Buttons"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 7

[node name="QuitButton" type="Button" parent="Center/Box/Panel/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"

[node name="Footer" type="Label" parent="."]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_top = -16.0
offset_bottom = -4.0
