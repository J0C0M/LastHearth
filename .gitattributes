# Normalize all text files to LF line endings
* text=auto eol=lf

# Godot text formats
*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.import  text eol=lf
*.cfg     text eol=lf
*.md      text eol=lf
*.sh      text eol=lf

# Images
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.svg     text eol=lf
*.aseprite binary
*.psd     binary

# Audio
*.wav     binary
*.ogg     binary
*.mp3     binary

# Fonts
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary

# Documents
*.docx    binary
*.pdf     binary
